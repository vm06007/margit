{
  "name": "margit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env server/src/index.ts",
    "build": "node scripts/check-site-assets.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "contracts:compile": "node scripts/compile-checkout.mjs",
    "contracts:test": "node --import tsx --test contracts/tests/checkout.test.ts",
    "contracts:deploy": "node --env-file=.env --import tsx scripts/deploy-checkout.ts --deploy",
    "graph:configure": "node --env-file=.env scripts/configure-subgraph.mjs",
    "graph:codegen": "graph codegen subgraph/subgraph.yaml --output-dir subgraph/generated",
    "graph:build": "graph build subgraph/subgraph.yaml --output-dir subgraph/build",
    "graph:deploy": "node --env-file=.env scripts/deploy-subgraph.mjs",
    "contracts:verify": "node scripts/verify-checkout.mjs",
    "mcp:check": "node --import tsx scripts/check-mcp.ts",
    "arc:readiness": "node --import tsx scripts/arc-readiness.ts",
    "arc:prepare-mainnet": "node --import tsx scripts/prepare-arc-mainnet.ts",
    "arc:test-release": "node --import tsx --test scripts/tests/arc-release.test.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@hono/node-server": "^1.19.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/redis": "^1.38.4",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.13.7",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thirdweb": "^5.121.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "solc": "0.8.36",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
