    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thirdweb": "^5.121.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
