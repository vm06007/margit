# GitHub OAuth App credentials — create one at
# https://github.com/settings/applications/new
# Authorization callback URL must match GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8788/api/auth/github/callback

# Frontend origin the API server redirects back to after login
APP_URL=http://localhost:5173

# Port the API server (Hono) listens on
PORT=8788

# Upstash Redis (REST API) — used for sessions and OAuth state
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AES-256-GCM key for encrypting GitHub tokens at rest (64 hex chars / 32 bytes).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
