# GitHub OAuth App credentials — create one at
# https://github.com/settings/applications/new
# Authorization callback URL must match GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8788/api/auth/github/callback

# Frontend origin the API server redirects back to after login
APP_URL=http://localhost:5173

# Port the API server (Hono) listens on
PORT=8788

# Upstash Redis (REST API) — used for sessions and OAuth state
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AES-256-GCM key for encrypting GitHub tokens at rest (64 hex chars / 32 bytes).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Arc (Circle L1) testnet — wallet that receives x402 payments. Public address only
# needed to receive funds; the private key is optional (only useful if you want to
# move funds later). Fund via https://faucet.circle.com ("Arc Testnet").
ARC_SELLER_PRIVATE_KEY=
ARC_SELLER_ADDRESS=

# This is the agent sidebar's own funded wallet — it pays for purchases the agent
# makes on a user's behalf, independent of any human buyer's connected wallet.
# Fund it via https://faucet.circle.com ("Arc Testnet") before trying a real buy.
ARC_DEMO_BUYER_PRIVATE_KEY=
ARC_DEMO_BUYER_ADDRESS=

# Shared/default OpenRouter API key — powers the agent sidebar's chat/reasoning
# for visitors who haven't brought their own key in Settings. OpenRouter
# (openrouter.ai) is one API that proxies many models (Anthropic, OpenAI,
# Google, free community models, etc.) — visitors can pick any of them in the
# sidebar's Settings panel, or supply their own OpenRouter key there instead.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Bazantic API key with the write role for gateway registration.
# A webapp session JWT is not accepted by the public API.
BAZANTIC_API_TOKEN=

# Thirdweb client ID (public, browser-safe) — free at https://thirdweb.com/dashboard
# (Settings > API Keys). Powers the Connect Wallet button and the real Buy flow.
VITE_THIRDWEB_CLIENT_ID=

# Contract checkout (Arc Testnet). Generated/configured by contracts:deploy.
CHECKOUT_CONTRACT_ADDRESS=
CHECKOUT_SIGNER_PRIVATE_KEY=

# The Graph Studio: MargitArc / margit-arc
GRAPH_NETWORK=arc-testnet
GRAPH_SUBGRAPH_SLUG=margit-arc
GRAPH_DEPLOY_KEY=
GRAPH_QUERY_URL=
GRAPH_QUERY_API_KEY=

# Hybrid publisher fees: use the current checkout address for settlement.
# Set launch time once (UTC ISO-8601); preserve it across restarts.
FEE_CONTRACT_ADDRESS=
PLATFORM_FEES_STARTED_AT=
