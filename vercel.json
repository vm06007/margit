{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{public/skills/margit/SKILL.md,node_modules/@circle-fin/cli/dist/index.js}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.margit.sh"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.margit.sh"
        }
      ],
      "destination": "/docs/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/((?!api/|assets/|site/|icons/|proofs/|skills/|docs/).*)",
      "destination": "/index.html"
    }
  ]
}
