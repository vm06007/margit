{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{public/skills/margit/SKILL.md,node_modules/@circle-fin/cli/dist/index.js}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "api.margit.sh"
        }
      ],
      "dest": "/api"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.margit.sh"
        }
      ],
      "dest": "/docs/index.html"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/docs/?",
      "dest": "/docs/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|assets/|site/|icons/|proofs/|skills/|docs/).*)",
      "dest": "/index.html"
    }
  ]
}
